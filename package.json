{
	"name": "zun-fitness",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "bun run db:migrate:local && vite dev --host 0.0.0.0 --port 3000",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply zun-fitness-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply zun-fitness-db --remote",
		"deploy": "bun run build && wrangler deploy"
	},
	"engines": {
		"bun": ">=1.0.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260714.1",
		"@iconify/svelte": "^5",
		"@internationalized/date": "^3.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"bits-ui": "^2.16.3",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.2",
		"wrangler": "^4.110.0"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.23",
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@lucide/svelte": "^1.24.0",
		"better-auth": "^1.6.23",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"tailwind-merge": "^3.6.0"
	}
}
